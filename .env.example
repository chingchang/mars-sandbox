# Copy this file to .env (gitignored; never commit it). The workshop server reads
# .env at start and keeps the key on the server; it never reaches the browser.
ANTHROPIC_API_KEY=
# Optional: the model behind the design agent (default claude-opus-5-5)
WORKSHOP_MODEL=
# Optional: the port the workshop server listens on (default 8787)
WORKSHOP_PORT=
