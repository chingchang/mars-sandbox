# Copy this file to .env (gitignored; never commit it). The workshop server reads
# .env at start and keeps the key on the server; it never reaches the browser.
ANTHROPIC_API_KEY=
# Optional: the model behind the design agent (default claude-opus-5-5)
WORKSHOP_MODEL=
# Optional: the port the workshop server listens on (default 8787)
WORKSHOP_PORT=
# Optional: extra page origins allowed to call the server, comma-separated. Pages on
# http://localhost or http://127.0.0.1 (any port) are always allowed; every other
# Origin gets 403, so a stray tab cannot spend the key.
WORKSHOP_ORIGINS=
# Optional: extra Host header values the server answers to, comma-separated
# (localhost and 127.0.0.1 always; anything else is refused against DNS rebinding).
WORKSHOP_HOSTS=
