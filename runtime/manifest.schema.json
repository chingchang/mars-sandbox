{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mars-sandbox.dev/runtime/manifest.schema.json",
  "title": "Mars Sandbox module manifest",
  "description": "Travels with a compiled module. The inspector renders state slots and signals from it, so it can show a type it has never seen; fact_ids let the inspector show the weakest provenance tier the module rests on.",
  "type": "object",
  "required": ["name", "description", "version", "author"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "version": { "type": "integer", "minimum": 1 },
    "author": { "type": "string", "minLength": 1, "maxLength": 64, "description": "player or agent name; the registry records the owner separately" },
    "state": {
      "type": "array", "maxItems": 16,
      "description": "what each state_set slot means; slots not listed are shown as raw numbers",
      "items": { "type": "object", "required": ["slot", "label"], "additionalProperties": false,
        "properties": { "slot": { "type": "integer", "minimum": 0, "maximum": 15 }, "label": { "type": "string", "maxLength": 48 }, "unit": { "type": "string", "maxLength": 16 } } }
    },
    "signals": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "emits":   { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/signal" } },
        "listens": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/signal" } }
      }
    },
    "shapes": { "type": "integer", "minimum": 0, "maximum": 32, "description": "how many shapes the module spawns at most" },
    "fact_ids": { "type": "array", "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
      "description": "fact ids the module depends on (through fact() or in its design); the inspector shows the weakest tier among them with citations" },
    "did_you_know": { "type": "object", "required": ["text", "fact_id"], "additionalProperties": false,
      "description": "one fact the design used, in the player's words, tied to a fact id that must also be in fact_ids so the inspector can show the citation",
      "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 300 }, "fact_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" } } }
  },
  "$defs": {
    "signal": { "type": "object", "required": ["code", "label"], "additionalProperties": false,
      "properties": { "code": { "type": "integer", "minimum": 0, "maximum": 65535 }, "label": { "type": "string", "maxLength": 48 }, "unit": { "type": "string", "maxLength": 16 } } }
  }
}
