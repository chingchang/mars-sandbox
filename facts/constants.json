      "value": 0.0319988, "unit": "kg/mol", "display_unit": "31.9988 g/mol",
      "uncertainty": { "type": "unstated", "note": "NIST WebBook gives relative molecular mass with no uncertainty" },
      "tier": "measured", "source_ids": ["nist-webbook-srd69"], "as_of": "2026-11"
    },
    {
      "id": "mars.atmosphere.mean_molar_mass",
      "label": "Mean molar mass of air",
      "value": 0.0436, "unit": "kg/mol",
      "uncertainty": { "type": "plus_minus", "value": 0.0002 },
      "tier": "derived", "formula": "mars.atmosphere.co2_fraction * chem.molar_mass.co2 + mars.atmosphere.ar40_fraction * chem.molar_mass.ar40 + mars.atmosphere.n2_fraction * chem.molar_mass.n2 + mars.atmosphere.o2_fraction * chem.molar_mass.o2", "depends_on": ["mars.atmosphere.co2_fraction", "mars.atmosphere.ar40_fraction", "mars.atmosphere.n2_fraction", "mars.atmosphere.o2_fraction", "chem.molar_mass.co2", "chem.molar_mass.ar40", "chem.molar_mass.n2", "chem.molar_mass.o2"],
      "source_ids": ["sam-mahaffy-2013", "nist-webbook-srd69", "nist-atomic-weights"], "as_of": "2013-07",
      "notes": "Needed for air density: rho = p*M/(R*T). At 700 Pa and 210 K this gives ~0.017 kg/m^3."
    },
    {
